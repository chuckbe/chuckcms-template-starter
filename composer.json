{
    "name": "chuckbe/chuckcms-template-starter",
    "description": "A ChuckCMS template named 'Starter' - lightweight and responsive.",
    "keywords": ["chuckbe", "chuckcms", "cms", "laravel", "php"],
    "homepage": "https://github.com/chuckbe/chuckcms-template-starter",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0||^11.0||^12.0||^13.0"
    },
    "conflict": {
        "chuckbe/chuckcms": "<0.3"
    },
    "authors": [
        {
            "name": "Karel Brijs",
            "email": "karel@chuck.be"
        }
    ],
    "autoload": {
        "psr-4": {
            "Chuckbe\\ChuckcmsTemplateStarter\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chuckbe\\ChuckcmsTemplateStarter\\ChuckcmsTemplateStarterServiceProvider"
            ],
            "aliases": {}
        }
    },
    "minimum-stability": "dev"
}
